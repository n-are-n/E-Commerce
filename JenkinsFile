pipeline {
    agent any
    stages {
        stage('Clean') {
            steps {
                bat 'dotnet clean'
            }
        }
        stage('Restore') {
            steps {
                bat 'dotnet restore'
            }
        }
        stage('Build') {
            steps {
                bat 'dotnet build --no-restore --configuration Release'
            }
        }
        stage('Test') {
            steps {
                bat 'dotnet test --no-build'
            }
        }
        stage('Run') {
            steps {
                bat 'dotnet run --no-build'
            }
        }
    }
}
