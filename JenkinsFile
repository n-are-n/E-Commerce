pipeline {
    agent any
    stages {
        stage('Clean') {
            steps {
                dir("API") {
                    bat 'dotnet clean'
                }
                dir("API.Tests") {
                    bat 'dotnet clean'
                }
            }
        }
        stage('Restore') {
            steps {
                dir("API") {
                    bat 'dotnet restore'
                }
                dir("API.Tests") {
                    bat 'dotnet restore'
                }
            }
        }
        stage('Build') {
            steps {
                dir("API") {
                    bat 'dotnet build --no-restore --configuration Release'
                }
                dir("API.Tests") {
                    bat 'dotnet build --no-restore --configuration Release'
                }
            }
        }
        stage('Test') {
            steps {
                dir("API.Tests") {
                    bat 'dotnet test --no-build'
                }
            }
        }
        stage('Run') {
            steps {
                dir("API") {
                    bat 'dotnet run --no-build'
                }
            }
        }
    }
}